<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_omx_description</name>
  <version>1.0.0</version>
  <description>
    TurtleBot3 Waffle Pi + OpenMANIPULATOR-X mobile manipulator (URDF + meshes),
    generated from a parametric SolidWorks 2025 model. Link/joint names and kinematics match
    turtlebot3_manipulation_description, so the official MoveIt 2 / Gazebo / Nav2 configs apply.
  </description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- only needed for the drop-in xacro (Gazebo / ros2_control / MoveIt) -->
  <exec_depend>turtlebot3_manipulation_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
